SEED_ADMIN_PASSWORD="change-me-admin"
SEED_STUDENT_EMAIL="student@artisanbarber.test"
SEED_STUDENT_PASSWORD="change-me-student"

# Academy authentication security
AUTH_IDENTIFIER_HASH_SECRET="replace-with-at-least-32-random-bytes"
